// ui/mainwindowwindow.slint


import { Button, VerticalBox } from "std-widgets.slint";
export component MainWindow inherits Window {
    in-out property <int> mainwindow_width;
    in-out property <int> mainwindow_height;
    property <int> xunit: mainwindow_width / 16.0;
    property <int> yunit: mainwindow_height / 16.0;
    width: mainwindow_width * 1px;
    height: mainwindow_height * 1px;
}